# Leave unset to use the local SQLite database (civicpulse.db).
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/civicpulse

# Set true behind HTTPS in production; leave false for local development.
COOKIE_SECURE=false

# Configure these to enable photo uploads to Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
